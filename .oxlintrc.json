{
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "coverage/**",
    "playwright-report/**",
    ".features-gen/**",
    "test-results/**",
    "worker-configuration.d.ts",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "eslint/no-unassigned-vars": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
